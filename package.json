{
  "name": "pro-client",
  "version": "1.3.0",
  "description": "Pro Client - Minecraft Launcher",
  "author": "OGBONEX_YT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OGBONEX/Pro-Launcher.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "update-electron-app": "^3.0.0",
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.18.1",
    "extract-zip": "^2.0.1",
    "tomate-loaders": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.proclient.launcher",
    "productName": "Pro Client",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
